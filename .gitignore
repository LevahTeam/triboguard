.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Downloaded research data and generated model artifacts are intentionally local.
# The small JSON evidence is copied into results/ and tracked, so a reviewer who
# clones the repository has the numbers the documentation quotes.
data/
runs/

# The web front end lives here now. It was a separate repository, which meant
# the root's status and releases could not see the site drifting -- and it did
# drift: the site shipped a different algorithm from the one the package used.
# Its own web/.gitignore still governs node_modules and the build output, since
# git honours nested ignore files.

# Source PDFs are third-party documents whose redistribution rights have not been
# confirmed. Keep them out of version control until that is settled.
*.pdf
